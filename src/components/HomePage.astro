---
import Base from '@/layouts/Base.astro';
import Hero from './Hero.astro';
import CompaniesBar from './CompaniesBar.astro';
import ExperienceSection from './ExperienceSection.astro';
import HowIWorkSection from './HowIWorkSection.astro';
import HighlightBand from './HighlightBand.astro';
import ProjectsSection from './ProjectsSection.astro';
import SkillsSection from './SkillsSection.astro';
import CertsSection from './CertsSection.astro';
import ContactSection from './ContactSection.astro';
import { profile } from '@/data/profile';
import type { Lang } from '@/data/i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const titleStr = lang === 'pt'
  ? `${profile.name} — Staff Security Engineer · AppSec · Cloud Security`
  : `${profile.name} — Staff Security Engineer · AppSec · Cloud Security`;
const descStr = lang === 'pt'
  ? 'Staff Security Engineer com 7+ anos em AppSec, DevSecOps e segurança cloud. Reduzi 569k → 318k vulnerabilidades na frete.com e desenvolvi ferramentas usadas por times de engenharia.'
  : 'Staff Security Engineer with 7+ years across AppSec, DevSecOps, and cloud security. Reduced Ubuntu vulnerabilities from 569k to 318k at frete.com and built tools used by engineering teams.';
---
<Base title={titleStr} description={descStr} lang={lang}>
  <!-- Hero + CompaniesBar above the fold (1 viewport min, minus sticky Nav h-16).
       pb-6 lifts CompaniesBar 24px off the viewport bottom edge.
       bg-bg-surface paints the pb gap with the same color as CompaniesBar,
       so no visible seam between bar and viewport edge. -->
  <section class="hero-fold relative flex flex-col min-h-[calc(100vh-4rem)] pb-6 bg-bg-surface">
    <Hero lang={lang} />
    <CompaniesBar lang={lang} />
  </section>

  <ExperienceSection lang={lang} />
  <HowIWorkSection lang={lang} />

  <!-- DRAMATIC HIGHLIGHT BAND between Method and Projects -->
  <HighlightBand lang={lang} />

  <ProjectsSection lang={lang} />
  <SkillsSection lang={lang} />
  <CertsSection lang={lang} />
  <ContactSection lang={lang} />
</Base>
