---
import ChdSection from './ChdSection.astro';
import { getCollection } from 'astro:content';
import { localizedUrl, type Lang } from '@/data/i18n';
import { toolIcons } from '@/data/tool-icons';

interface Props { lang: Lang }
const { lang } = Astro.props;
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

/* The stack is proven by the case studies, not asserted: each tool counts
   the cases whose `stack` lists it, and opens a list of those cases. A tool
   with no case yet still shows, without a count.
   - `icon`: simple-icons slug in `tool-icons.ts`, drawn inline.
   - `file`: a mark in `public/images/tools/` for tools simple-icons lacks,
     painted through a CSS mask so it takes the same single colour. `lum`
     masks by brightness, for marks that are a light glyph on a solid tile.
     Sources: Material Design Icons (Apache-2.0: aws, azure, windows-server,
     powershell, x86, active-directory, soc2, sysmon, polaris), Devicon (MIT:
     ghidra), File Icons (ISC: nessus), SVG Logos (CC0: zabbix), Wikimedia
     Commons (sentinelone, iso), and each vendor's own site or repo
     (semgrep, cis, defectdojo, nist, jumpcloud, xbow, suricata, wazuh).
   - `match`: the names the case frontmatter uses for the same tool. */
interface Tool { name: string; icon?: string; file?: string; lum?: boolean; match?: string[] }
interface Domain {
  label: { en: string; pt: string };
  note: { en: string; pt: string };
  pixel: string;
  tools: Tool[];
}

const domains: Domain[] = [
  {
    label: { en: 'DevSecOps', pt: 'DevSecOps' },
    note: { en: 'Security gates in the pipeline', pt: 'Gates de segurança no pipeline' },
    pixel: 'fc126',
    tools: [
      { name: 'Snyk', icon: 'snyk', match: ['Snyk', 'Snyk CLI'] },
      { name: 'GitHub Actions', icon: 'githubactions' },
      { name: 'GitLab', icon: 'gitlab', match: ['GitLab Ultimate', 'GitLab CI'] },
      { name: 'Semgrep', file: 'semgrep.svg' },
      { name: 'Checkmarx', icon: 'checkmarx' },
      { name: 'Kics', icon: 'checkmarx' },
      { name: 'Polaris', file: 'polaris.svg' },
      { name: 'Jenkins', icon: 'jenkins' },
    ],
  },
  {
    label: { en: 'Cloud', pt: 'Cloud' },
    note: { en: 'Platforms and the edge', pt: 'Plataformas e borda' },
    pixel: 'fc793',
    tools: [
      { name: 'AWS', file: 'aws.svg', match: ['AWS', 'AWS Inspector'] },
      { name: 'Google Cloud', icon: 'googlecloud', match: ['GCP'] },
      { name: 'Cloudflare WAF', icon: 'cloudflare', match: ['Cloudflare WAF', 'WAF'] },
      { name: 'Azure', file: 'azure.svg' },
      { name: 'Kubernetes', icon: 'kubernetes' },
      { name: 'Docker', icon: 'docker' },
      { name: 'Akamai', icon: 'akamai' },
    ],
  },
  {
    label: { en: 'Detection & SOC', pt: 'Detecção & SOC' },
    note: { en: 'SIEM, EDR and monitoring', pt: 'SIEM, EDR e monitoramento' },
    pixel: 'fc664',
    tools: [
      { name: 'Wazuh', file: 'wazuh.png', lum: true },
      { name: 'SentinelOne', file: 'sentinelone.svg', match: ['SentinelOne', 'SentinelOne API'] },
      { name: 'Grafana', icon: 'grafana' },
      { name: 'Bitdefender', icon: 'bitdefender' },
      { name: 'Elastic', icon: 'elastic' },
      { name: 'Sysmon', file: 'sysmon.svg' },
      { name: 'Zabbix', file: 'zabbix.svg', lum: true },
      { name: 'Prometheus', icon: 'prometheus' },
    ],
  },
  {
    label: { en: 'Vulns & compliance', pt: 'Vulns & compliance' },
    note: { en: 'Scanners, tracking and frameworks', pt: 'Scanners, gestão e frameworks' },
    pixel: 'fc855',
    tools: [
      { name: 'NIST CSF 2.0', file: 'nist.svg' },
      { name: 'DefectDojo', file: 'defectdojo.svg' },
      { name: 'CIS Benchmarks', file: 'cis.svg' },
      { name: 'ISO 27001', file: 'iso.svg' },
      { name: 'Jira', icon: 'jira' },
      { name: 'Nessus', file: 'nessus.svg' },
      { name: 'SOC 2', file: 'soc2.svg', match: ['SOC 2 Type 2'] },
      { name: 'Qualys', icon: 'qualys' },
    ],
  },
  {
    label: { en: 'Infra & identity', pt: 'Infra & identidade' },
    note: { en: 'Servers, network and access', pt: 'Servidores, rede e acesso' },
    pixel: 'fc2',
    tools: [
      { name: 'Linux', icon: 'linux', match: ['Linux', 'Ubuntu', 'Ubuntu 22.04'] },
      { name: 'Active Directory', file: 'active-directory.svg', match: ['Active Directory', 'GPO'] },
      { name: 'pfSense', icon: 'pfsense' },
      { name: 'Suricata', file: 'suricata.png' },
      { name: 'Windows Server', file: 'windows-server.svg', match: ['Windows'] },
      { name: 'JumpCloud', file: 'jumpcloud.svg' },
    ],
  },
  {
    label: { en: 'Automation', pt: 'Automação' },
    note: { en: 'Languages I build tooling in', pt: 'Linguagens das minhas ferramentas' },
    pixel: 'fc848',
    tools: [
      { name: 'Python', icon: 'python' },
      { name: 'Go', icon: 'go' },
      { name: 'Bash', icon: 'gnubash' },
      { name: 'PowerShell', file: 'powershell.svg' },
      { name: 'Node-RED', icon: 'nodered' },
    ],
  },
  {
    label: { en: 'Offensive & RE', pt: 'Ofensivo & RE' },
    note: { en: 'Pentest and reverse engineering', pt: 'Pentest e engenharia reversa' },
    pixel: 'fc673',
    tools: [
      { name: 'x86 Assembly', file: 'x86.svg' },
      { name: 'C', icon: 'c' },
      { name: 'Ghidra', file: 'ghidra.svg' },
      { name: 'Burp Suite', icon: 'burpsuite' },
      { name: 'XBOW', file: 'xbow.svg' },
    ],
  },
];

const projects = (await getCollection('projects'))
  .filter((entry) => entry.id.startsWith(`${lang}/`) && !entry.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const slugOf = (id: string) => id.replace(/^[a-z]{2}\//, '').replace(/\.mdx$/, '');

const cards = domains.map((domain) => ({
  label: domain.label[lang],
  note: domain.note[lang],
  pixel: domain.pixel,
  tools: domain.tools
    .map((tool) => {
      const names = tool.match ?? [tool.name];
      const cases = projects
        .filter((p) => p.data.stack.some((s) => names.includes(s)))
        .map((p) => ({
          title: p.data.title.split(' — ')[0],
          href: localizedUrl(`/projects/${slugOf(p.id)}/`, lang),
        }));
      return { ...tool, path: tool.icon ? toolIcons[tool.icon] : undefined, cases };
    })
    // Most-proven first; the declared order breaks ties.
    .sort((a, b) => b.cases.length - a.cases.length),
}));

const copy = lang === 'pt'
  ? {
      kicker: 'STACK / PROVADA EM PRODUÇÃO',
      title: 'COM O QUE EU TRABALHO.',
      lede: 'Ferramentas por domínio. O número é em quantos estudos de caso cada uma aparece — clique para abrir os casos.',
      cases: (n: number) => `${n} ${n === 1 ? 'caso' : 'casos'}`,
    }
  : {
      kicker: 'STACK / PROVEN IN PRODUCTION',
      title: 'WHAT I WORK WITH.',
      lede: 'Tools by domain. The number is how many case studies each one appears in — click to open them.',
      cases: (n: number) => `${n} ${n === 1 ? 'case' : 'cases'}`,
    };
---
<ChdSection id="skills" class="chd-skills-section chd-section--grows" labelledBy="skills-title" motionClass="chd-skills-motion">
  <div class="section-heading section-heading--split">
    <div>
      <p class="section-kicker">{copy.kicker}</p>
      <h2 id="skills-title">{copy.title}</h2>
    </div>
    <p>{copy.lede}</p>
  </div>

  <ol class="chd-stack">
    {cards.map((card) => (
      <li class="chd-stack__card">
        <header class="chd-stack__head">
          <img src={`${base}/fonts/icons/${card.pixel}.png`} alt="" width="40" height="40" loading="lazy" decoding="async" />
          <span>
            <strong>{card.label}</strong>
            <small>{card.note}</small>
          </span>
        </header>
        <ul class="chd-stack__tools">
          {card.tools.map((tool) => {
            const mark = tool.path ? (
              <svg class="chd-stack__mark" viewBox="0 0 24 24" aria-hidden="true"><path d={tool.path} /></svg>
            ) : (
              <span
                class:list={['chd-stack__mark', 'chd-stack__mark--file', { 'is-lum': tool.lum }]}
                style={`--mark: url('${base}/images/tools/${tool.file}')`}
                aria-hidden="true"
              ></span>
            );
            return (
              <li>
                {tool.cases.length ? (
                  <details class="chd-stack__tool is-proven">
                    <summary>
                      {mark}
                      <span class="chd-stack__name">{tool.name}</span>
                      <span class="chd-stack__count" title={copy.cases(tool.cases.length)}>
                        <span class="sr-only">{copy.cases(tool.cases.length)}</span>
                        <span aria-hidden="true">{tool.cases.length}</span>
                      </span>
                    </summary>
                    <ul class="chd-stack__cases">
                      {tool.cases.map((c) => <li><a href={c.href}>{c.title} →</a></li>)}
                    </ul>
                  </details>
                ) : (
                  <span class="chd-stack__tool">
                    {mark}
                    <span class="chd-stack__name">{tool.name}</span>
                  </span>
                )}
              </li>
            );
          })}
        </ul>
      </li>
    ))}
  </ol>
</ChdSection>

<script>
  // One open case list at a time, closed by a click elsewhere or Escape.
  const tools = Array.from(document.querySelectorAll<HTMLDetailsElement>('.chd-stack__tool.is-proven'));
  for (const tool of tools) {
    tool.addEventListener('toggle', () => {
      if (tool.open) tools.forEach((other) => { if (other !== tool) other.open = false; });
    });
  }
  document.addEventListener('click', (event) => {
    if (!(event.target as Element).closest('.chd-stack__tool')) tools.forEach((t) => (t.open = false));
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') tools.forEach((t) => (t.open = false));
  });
</script>

<style>
  :global(.chd-skills-motion) {
    grid-template-rows: auto auto;
    gap: clamp(1rem, 2.5vh, 2rem);
    display: grid;
  }
  /* The case list floats over the next card, so this panel must not clip it. */
  :global(.snap-section.chd-skills-section.chd-section--grows),
  :global(.snap-section.chd-skills-section.chd-section--grows > .snap-section__motion) {
    overflow: visible;
  }

  /* Seven cards on a 12-column grid: four across, then three wider ones, so
     the last row has no empty cell. */
  .chd-stack {
    grid-template-columns: repeat(12, minmax(0, 1fr));
    border-top: 1px solid var(--chd-rule);
    border-left: 1px solid var(--chd-rule);
    align-self: start;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
  }
  .chd-stack__card {
    border-right: 1px solid var(--chd-rule);
    border-bottom: 1px solid var(--chd-rule);
    grid-column: span 3;
    min-width: 0;
    padding: clamp(0.9rem, 1.5vw, 1.25rem);
  }
  .chd-stack__card:nth-child(n + 5) {
    grid-column: span 4;
  }
  .chd-stack__head {
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.9rem;
    display: flex;
  }
  .chd-stack__head img {
    image-rendering: pixelated;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
  }
  .chd-stack__head > span {
    gap: 0.2rem;
    min-width: 0;
    display: grid;
  }
  .chd-stack__head strong {
    color: var(--chd-paper);
    font-size: var(--chd-type-control);
    font-weight: 400;
    text-transform: uppercase;
    line-height: 1;
  }
  .chd-stack__head small {
    color: var(--chd-text-muted);
    font-size: var(--chd-type-meta);
    line-height: 1.1;
  }

  .chd-stack__tools {
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
  }
  .chd-stack__tool {
    position: relative;
  }
  .chd-stack__tool > summary,
  span.chd-stack__tool {
    grid-template-columns: 1.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.6rem;
    padding: 0.3rem 0.4rem;
    display: grid;
  }
  .chd-stack__tool > summary {
    cursor: pointer;
    list-style: none;
  }
  .chd-stack__tool > summary::-webkit-details-marker {
    display: none;
  }
  .chd-stack__mark {
    fill: currentColor;
    color: var(--chd-paper);
    width: 1.25rem;
    height: 1.25rem;
    justify-self: center;
  }
  /* File marks are painted through a mask, so every logo takes the text
     colour whatever its original palette. */
  .chd-stack__mark--file {
    background: currentColor;
    -webkit-mask: var(--mark) center / contain no-repeat;
    mask: var(--mark) center / contain no-repeat;
    display: block;
  }
  .chd-stack__mark--file.is-lum {
    mask-mode: luminance;
  }
  .chd-stack__name {
    color: var(--chd-paper);
    font-size: var(--chd-type-meta);
    white-space: nowrap;
    text-overflow: ellipsis;
    line-height: 1.1;
    overflow: hidden;
  }
  .chd-stack__count {
    color: var(--chd-signal-text);
    font-size: var(--chd-type-meta);
    min-width: 1.5rem;
    text-align: right;
  }
  /* Tools no case uses yet step back. */
  span.chd-stack__tool :is(.chd-stack__mark, .chd-stack__name) {
    color: var(--chd-text-muted);
  }
  .chd-stack__tool.is-proven > summary:hover,
  .chd-stack__tool.is-proven > summary:focus-visible,
  .chd-stack__tool[open] > summary {
    background: var(--chd-paper);
  }
  .chd-stack__tool.is-proven > summary:hover *,
  .chd-stack__tool.is-proven > summary:focus-visible *,
  .chd-stack__tool[open] > summary * {
    color: var(--chd-ink);
  }

  .chd-stack__cases {
    z-index: 20;
    border: 1px solid var(--chd-paper);
    background: var(--chd-ink);
    margin: 0.2rem 0 0;
    padding: 0.3rem 0;
    list-style: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
  }
  .chd-stack__cases a {
    color: var(--chd-paper);
    font-size: var(--chd-type-meta);
    padding: 0.45rem 0.75rem;
    line-height: 1.2;
    display: block;
  }
  .chd-stack__cases a:hover,
  .chd-stack__cases a:focus-visible {
    background: var(--chd-paper);
    color: var(--chd-ink);
  }

  @media (max-width: 1100px) {
    .chd-stack__card,
    .chd-stack__card:nth-child(n + 5) {
      grid-column: span 6;
    }
    .chd-stack__card:last-child {
      grid-column: span 12;
    }
    .chd-stack__card:last-child .chd-stack__tools {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
    }
  }
  @media (max-width: 700px) {
    .chd-stack__card,
    .chd-stack__card:nth-child(n + 5),
    .chd-stack__card:last-child {
      grid-column: span 12;
    }
    /* Two tools per line keeps seven domains from becoming one long column. */
    .chd-stack__card .chd-stack__tools,
    .chd-stack__card:last-child .chd-stack__tools {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 0.5rem;
    }
    .chd-stack__card {
      padding: 0.85rem 0.6rem;
    }
    .chd-stack__tool > summary,
    span.chd-stack__tool {
      grid-template-columns: 1.5rem minmax(0, 1fr) auto;
      gap: 0.4rem;
      min-height: 2.5rem;
      padding: 0.3rem 0.2rem;
    }
    /* Half a card is too narrow to clip names: let them take two lines. */
    .chd-stack__name {
      white-space: normal;
      overflow-wrap: anywhere;
    }
    .chd-stack__count {
      min-width: 0.75rem;
    }
    /* No room to float on a phone: the list opens in place, across the card. */
    .chd-stack__tools > li:has(> details[open]) {
      grid-column: 1 / -1;
    }
    .chd-stack__cases {
      position: static;
    }
  }
</style>
