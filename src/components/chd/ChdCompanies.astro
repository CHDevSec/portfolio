---
import type { Lang } from '@/data/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

interface Company {
  name: string;
  logo: string;
  role: string;
  href?: string;
}

const companies: Company[] = [
  { name: 'frete.com', logo: 'frete.png', role: 'LOGISTICS SAAS · SERIES C', href: 'https://frete.com' },
  { name: 'SoftExpert', logo: 'softexpert.svg', role: 'ENTERPRISE SOFTWARE · ECM/BPM', href: 'https://www.softexpert.com' },
  { name: 'Volt Sport', logo: 'logo-volt.svg', role: 'SPORTSWEAR', href: 'https://www.voltsport.com.br/' },
  { name: 'Global Estratégias', logo: 'global.png', role: 'FINTECH', href: 'https://somosglobal.com.br/' },
  { name: 'Evolution', logo: 'evolutionsul.avif', role: 'TECHNOLOGY', href: 'https://www.evolutionsul.com.br/' },
  { name: 'CHDevSec', logo: 'chdevsec.png', role: 'INDEPENDENT · CONSULTING', href: 'https://chdevsec.com.br/' },
];

const kicker = lang === 'pt'
  ? 'EM PRODUÇÃO / ONDE JÁ ENTREGUEI'
  : 'IN PRODUCTION / WHERE I SHIPPED';
const ariaLabel = lang === 'pt'
  ? 'Empresas onde estive em produção'
  : 'Companies where I shipped in production';

// Track is duplicated so the marquee can loop without a visible seam.
const track = [...companies, ...companies];
---
<section class="chd-companies" aria-label={ariaLabel}>
  <p class="section-kicker">{kicker}</p>
  <div class="chd-companies__viewport" data-chd-marquee>
    <ul class="chd-companies__track">
      {track.map((company, index) => (
        <li class="chd-companies__item" aria-hidden={index >= companies.length ? 'true' : undefined}>
          <a
            class="chd-companies__card"
            href={company.href}
            target={company.href ? '_blank' : undefined}
            rel={company.href ? 'noreferrer' : undefined}
            tabindex={index >= companies.length ? -1 : undefined}
          >
            <img src={`${base}/company/${company.logo}`} alt={company.name} loading="lazy" decoding="async" />
            <span class="chd-companies__name">{company.name}</span>
            <span class="chd-companies__role">{company.role}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .chd-companies {
    border-top: 1px solid var(--chd-rule);
    padding: clamp(1.25rem, 3vh, 2.25rem) 0 0;
  }
  .chd-companies .section-kicker {
    padding: 0 var(--page-pad);
  }
  .chd-companies__viewport {
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent,
      #000 7rem,
      #000 calc(100% - 7rem),
      transparent
    );
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 7rem,
      #000 calc(100% - 7rem),
      transparent
    );
    margin-top: clamp(0.75rem, 2vh, 1.5rem);
    overflow: hidden;
  }
  .chd-companies__track {
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    animation: chd-marquee 38s linear infinite;
  }
  .chd-companies__viewport:hover .chd-companies__track,
  .chd-companies__viewport:focus-within .chd-companies__track {
    animation-play-state: paused;
  }
  @keyframes chd-marquee {
    to {
      /* The track holds the list twice, so one list width is a full cycle. */
      transform: translateX(-50%);
    }
  }
  .chd-companies__item {
    flex: none;
  }
  .chd-companies__card {
    border-right: 1px solid var(--chd-rule);
    align-content: center;
    gap: 0.4rem;
    width: clamp(13rem, 20vw, 17rem);
    min-height: 8.5rem;
    padding: 1.25rem 1.5rem;
    color: var(--chd-paper-muted);
    text-decoration: none;
    transition: background-color 0.14s, color 0.14s;
    display: grid;
  }
  .chd-companies__card:hover,
  .chd-companies__card:focus-visible {
    background: var(--chd-paper);
    color: var(--chd-ink);
  }
  .chd-companies__card img {
    object-fit: contain;
    object-position: left center;
    width: auto;
    max-width: 8.5rem;
    height: 1.9rem;
    /* Logos arrive in mixed colours; flatten them to the page palette. */
    filter: grayscale(1) brightness(1.9) contrast(1.1);
    transition: filter 0.14s;
  }
  .chd-companies__card:hover img,
  .chd-companies__card:focus-visible img {
    filter: grayscale(1) brightness(0.35) contrast(1.3);
  }
  .chd-companies__name {
    font-size: var(--chd-type-control);
    line-height: 1;
  }
  .chd-companies__role {
    color: var(--chd-text-muted);
    font-size: var(--chd-type-meta);
    line-height: 1.1;
  }
  .chd-companies__card:hover .chd-companies__role,
  .chd-companies__card:focus-visible .chd-companies__role {
    color: var(--chd-ink);
  }
  @media (prefers-reduced-motion: reduce) {
    .chd-companies__track {
      animation: none;
    }
    .chd-companies__viewport {
      -webkit-mask-image: none;
      mask-image: none;
      overflow-x: auto;
    }
  }
</style>
