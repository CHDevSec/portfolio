---
interface Props {
  src: string;
  alt: string;
}
const { src, alt } = Astro.props;
---
<figure class="chd-portrait" data-chd-portrait data-src={src} data-rendered="false">
  <canvas class="chd-portrait__canvas" role="img" aria-label={alt}></canvas>
</figure>

<style>
  .chd-portrait {
    z-index: 2;
    aspect-ratio: 3 / 4;
    border: 1px solid var(--chd-rule);
    background: var(--chd-ink);
    margin: 0;
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .chd-portrait__canvas {
    opacity: 0;
    transition: opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1);
    width: 100%;
    height: 100%;
    display: block;
  }
  .chd-portrait[data-rendered='true'] .chd-portrait__canvas {
    opacity: 1;
  }
</style>
