---
interface Props { lang?: 'en' | 'pt' }
const { lang = 'en' } = Astro.props;
const copy = lang === 'pt'
  ? { aria: 'Estrutura de uma página de dados JET4', table: 'TABELA DE OFFSETS', grows: 'cresce →', free: 'ESPAÇO LIVRE', new: 'NOVA LINHA', insert: 'INSERÇÃO', page: 'PÁGINA JET4 · 4.096 bytes', writes: '← inserção binária', offset: 'offset incluído (2 bytes)', caption: 'A página JET4 guarda um cabeçalho, a tabela de offsets, espaço livre e linhas organizadas a partir do fim. A nova linha ocupa o espaço livre; seu offset é acrescentado à tabela.' }
  : { aria: 'JET4 data page structure', table: 'ROW OFFSET', grows: 'grows →', free: 'FREE SPACE', new: 'NEW ROW', insert: 'INSERT', page: 'JET4 DATA PAGE — 4,096 bytes', writes: '← binary insertion', offset: 'offset added here (2 bytes)', caption: 'A JET4 page stores a header, row-offset table, free space, and rows packed from the end. The new row uses free space; its offset is added to the table.' };
---
<figure aria-label={copy.aria} style="overflow-x:auto">
        <svg viewBox="0 0 680 180" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={copy.aria} style="width:100%;min-width:680px;max-width:680px;display:block;margin:0 auto">
          <!-- Page border -->
          <rect x="2" y="20" width="676" height="120" fill="#0a0a0a" stroke="#5a5a56" stroke-width="2"/>
          <!-- Page header (first 32 bytes) -->
          <rect x="2" y="20" width="60" height="120" fill="#141414" stroke="#5a5a56" stroke-width="1"/>
          <text x="32" y="76" text-anchor="middle" font-family="'Press Start 2P',monospace" font-size="7" fill="#6d6d68">PAGE</text>
          <text x="32" y="90" text-anchor="middle" font-family="'Press Start 2P',monospace" font-size="7" fill="#6d6d68">HDR</text>
          <text x="32" y="104" text-anchor="middle" font-family="JetBrains Mono,monospace" font-size="8" fill="#7f9da5">32B</text>
          <!-- Row offset table (grows right) -->
          <rect x="62" y="20" width="160" height="120" fill="#101010" stroke="#5a5a56" stroke-width="1"/>
          <text x="142" y="70" text-anchor="middle" font-family="'Press Start 2P',monospace" font-size="7" fill="#6fa3ff">{copy.table}</text>
          <text x="142" y="100" text-anchor="middle" font-family="JetBrains Mono,monospace" font-size="8" fill="#7f9da5">{copy.grows}</text>
          <!-- Arrow right -->
          <text x="230" y="85" text-anchor="middle" font-family="JetBrains Mono,monospace" font-size="14" fill="#5a5a56">→</text>
          <!-- Free space (middle) -->
          <rect x="245" y="20" width="190" height="120" fill="#0a0a0a"/>
          <text x="340" y="80" text-anchor="middle" font-family="JetBrains Mono,monospace" font-size="9" fill="#5a5a56">{copy.free}</text>
          <!-- Arrow left -->
          <text x="443" y="85" text-anchor="middle" font-family="JetBrains Mono,monospace" font-size="14" fill="#5a5a56">←</text>
          <!-- Rows (packed from end, growing left) -->
          <rect x="458" y="20" width="60" height="120" fill="#101010" stroke="#1e6bff" stroke-width="1"/>
          <text x="488" y="72" text-anchor="middle" font-family="'Press Start 2P',monospace" font-size="6" fill="#1e6bff">ROW</text>
          <text x="488" y="84" text-anchor="middle" font-family="'Press Start 2P',monospace" font-size="6" fill="#1e6bff">N+1</text>
          <rect x="518" y="20" width="60" height="120" fill="#101010" stroke="#1e6bff" stroke-width="1"/>
          <text x="548" y="72" text-anchor="middle" font-family="'Press Start 2P',monospace" font-size="6" fill="#1e6bff">ROW</text>
          <text x="548" y="84" text-anchor="middle" font-family="'Press Start 2P',monospace" font-size="6" fill="#1e6bff">N</text>
          <rect x="578" y="20" width="60" height="120" fill="#141414" stroke="#1e6bff" stroke-width="2"/>
          <text x="608" y="72" text-anchor="middle" font-family="'Press Start 2P',monospace" font-size="6" fill="#1e6bff">{copy.new}</text>
          <text x="608" y="88" text-anchor="middle" font-family="'Press Start 2P',monospace" font-size="6" fill="#1e6bff">{copy.insert}</text>
          <rect x="638" y="20" width="40" height="120" fill="#0a0a0a" stroke="#5a5a56" stroke-width="1"/>
          <text x="658" y="76" text-anchor="middle" font-family="JetBrains Mono,monospace" font-size="7" fill="#5a5a56">...</text>
          <!-- Labels -->
          <text x="340" y="15" text-anchor="middle" font-family="JetBrains Mono,monospace" font-size="10" fill="#d8d8d2">{copy.page}</text>
          <text x="608" y="155" text-anchor="middle" font-family="JetBrains Mono,monospace" font-size="9" fill="#1e6bff">{copy.writes}</text>
          <text x="142" y="155" text-anchor="middle" font-family="JetBrains Mono,monospace" font-size="9" fill="#6fa3ff">{copy.offset}</text>
        </svg>
        <figcaption>{copy.caption}</figcaption>
      </figure>
