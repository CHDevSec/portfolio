---
import { getCollection } from 'astro:content';
import ChdProject from '@/layouts/ChdProject.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects
    .filter((project) => project.slug.startsWith('pt/'))
    .map((project) => ({
      params: { slug: project.slug.replace(/^pt\//, '') },
      props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await project.render();
---
<ChdProject project={project} lang="pt">
  <Content />
</ChdProject>
